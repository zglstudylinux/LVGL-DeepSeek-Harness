{
  "folders": [
    { "path": "." }
  ],
  "settings": {
    "cmake.buildDirectory": "${workspaceFolder}/build",
    "cmake.configureOnOpen": false
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Debug demo_widgets (pc_sdl)",
        "type": "cppdbg",
        "request": "launch",
        "program": "${workspaceFolder}/bin/demo_widgets.exe",
        "args": [],
        "stopAtEntry": false,
        "cwd": "${workspaceFolder}",
        "environment": [],
        "externalConsole": false,
        "MIMode": "gdb",
        "miDebuggerPath": "C:\\Users\\admin\\msys64\\ucrt64\\bin\\gdb.exe",
        "setupCommands": [
          {
            "description": "Enable pretty-printing for gdb",
            "text": "-enable-pretty-printing",
            "ignoreFailures": true
          }
        ],
        "preLaunchTask": "build"
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "build",
        "type": "shell",
        "command": "powershell",
        "args": [ "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/build.ps1", "-App", "demo_widgets" ],
        "group": { "kind": "build", "isDefault": true },
        "problemMatcher": []
      }
    ]
  }
}
